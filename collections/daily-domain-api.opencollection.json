{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daily batch/rooms domain API",
    "version": "1.1.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "domain",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get domain configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.daily.co/v1/",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get top-level configuration of your domain"
        },
        {
          "info": {
            "name": "Set domain configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.daily.co/v1/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Set top-level configuration options for your domain"
        }
      ]
    }
  ],
  "bundled": true
}