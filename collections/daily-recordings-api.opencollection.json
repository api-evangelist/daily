{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daily batch/rooms recordings API",
    "version": "1.1.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "recordings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "/recordings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.daily.co/v1/recordings",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "ending_before",
                "value": "",
                "type": "query"
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "room_name",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List recordings"
        },
        {
          "info": {
            "name": "recordings/:id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.daily.co/v1/recordings/:recording_id",
            "params": [
              {
                "name": "recording_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get info about a recording"
        },
        {
          "info": {
            "name": "recordings/:id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.daily.co/v1/recordings/:recording_id",
            "params": [
              {
                "name": "recording_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a recording"
        },
        {
          "info": {
            "name": "recordings/:id/access-link",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.daily.co/v1/recordings/:recording_id/access-link",
            "params": [
              {
                "name": "recording_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate an access link for a recording"
        }
      ]
    }
  ],
  "bundled": true
}