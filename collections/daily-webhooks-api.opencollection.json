        },
        {
          "info": {
            "name": "webhooks/:id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.daily.co/v1/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
