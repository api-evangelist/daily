{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daily batch/rooms presence API",
    "version": "1.1.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "presence",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "/presence",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.daily.co/v1/presence",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "/presence"
        }
      ]
    }
  ],
  "bundled": true
}