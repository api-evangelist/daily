{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daily batch/rooms webhooks API",
    "version": "1.1.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
